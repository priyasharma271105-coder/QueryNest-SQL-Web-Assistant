{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QueryNestS3Permissions",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::querynest-storage-bucket",
        "arn:aws:s3:::querynest-storage-bucket/*"
      ]
    },
    {
      "Sid": "QueryNestCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:ap-south-1:*:log-group:/querynest/*"
    },
    {
      "Sid": "QueryNestSecretsManager",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:*:secret:querynest/app/secrets*"
    },
    {
      "Sid": "QueryNestLambdaInvocation",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:*:function:querynest-*"
    },
    {
      "Sid": "QueryNestCloudTrailAudit",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:DescribeTrails",
        "cloudtrail:LookupEvents"
      ],
      "Resource": "*"
    }
  ]
}