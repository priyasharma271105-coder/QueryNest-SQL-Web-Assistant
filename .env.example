# ── MongoDB Settings ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
DB_NAME=QueryNest

# ── Flask Settings ─────────────────────────────────────────────────
SECRET_KEY=querynest_secret_key_2024
DEBUG=true
PORT=5000

# ── AWS Integration Settings ───────────────────────────────────────
# Set AWS_ENABLED=true to connect real AWS services.
# When AWS_ENABLED=false, QueryNest runs in 100% offline Local Development Mode.
AWS_ENABLED=false
AWS_REGION=ap-south-1

# AWS IAM Credentials (leave blank for local mode; never commit real keys to git)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS S3 (Bucket for storing generated PDFs and uploaded code files)
S3_BUCKET_NAME=querynest-storage-bucket

# AWS CloudWatch (Application logs & metrics)
CLOUDWATCH_LOG_GROUP=/querynest/app-logs
CLOUDWATCH_LOG_STREAM=flask-server

# AWS CloudTrail (Security auditing & API activity tracking)
CLOUDTRAIL_NAME=querynest-management-trail

# AWS Lambda (Serverless SQL Formatter & Syntax Validator)
LAMBDA_SQL_FORMATTER=querynest-sql-formatter

# AWS Secrets Manager (Production secret name for API keys & DB credentials)
AWS_SECRET_NAME=querynest/app/secrets

# AWS SNS (Notifications)
AWS_SNS_TOPIC_ARN=

# ── AI Client (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Email Settings ─────────────────────────────────────────────────
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
TEST_MODE=false

# ── Razorpay Payment Gateway ───────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
